flowchart TD

S(["Mulai: Mahasiswa membuka aplikasi MoneyTrack"]) 

S --> A["Halaman Login"]

A --> B{"Akun valid?"}

B -- "Tidak" --> C["Tampilkan pesan login gagal"]
C --> A

