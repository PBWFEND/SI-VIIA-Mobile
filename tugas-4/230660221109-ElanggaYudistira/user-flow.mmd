G -- "Tidak" --> H["Tampilkan pesan kesalahan<br/>Lengkapi data transaksi"]
H --> F

G -- "Ya" --> I["Simpan transaksi"]

I --> J{"Kategori transaksi tersedia?"}

J -- "Tidak" --> K["Buat kategori baru"]
K --> I

J -- "Ya" --> L["Sistem memperbarui daftar transaksi"]

L --> M["Halaman Riwayat Transaksi"]

M --> N["Mahasiswa melihat transaksi tersimpan"]

N --> T(["Selesai: Transaksi berhasil dicatat"])
